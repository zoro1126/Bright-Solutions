          style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="960" y="87" width="150" height="35" as="geometry" />
        </mxCell>

        <!-- Left Column: Live Streaming Transcript (Speaker Diarized) -->
        <mxCell id="panel-transcript" value=""
          style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="35" y="145" width="460" height="595" as="geometry" />
        </mxCell>

        <mxCell id="hdr-transcript" value="Live Streaming Dialogue (Deepgram Nova-2 Medical)"
          style="rounded=0;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;fontSize=10;fontStyle=1;align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="35" y="145" width="460" height="35" as="geometry" />
        </mxCell>

        <mxCell id="t-seg-1" value="[00:12] Dr. Kulkarni: Good morning Mr. Ramesh. What brings you to the clinic today?&#xa;[00:18] Patient: Doctor, for the past 4 days I have this tightness in the center of my chest whenever I climb stairs. It goes away when I rest."
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t-seg-2" value="[00:54] Dr. Kulkarni: Does the tightness radiate to your left arm or jaw? Any sweating or nausea?&#xa;[01:05] Patient: A little numbness in the left shoulder yes, but no sweating. My father had a heart attack at age 58."
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="260" width="430" height="60" as="geometry" />
        </mxCell>

        <mxCell id="t-seg-3" value="[02:15] Dr. Kulkarni: Let's examine your blood pressure. It is 168 over 102, which is elevated. Pulse is 104 regular. Lungs are clear on auscultation. S1 and S2 present, no murmurs.&#xa;[03:10] Dr. Kulkarni: We need an urgent 12-lead ECG, troponin, and start you on sublingual nitroglycerin if pain returns."
          style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="430" height="85" as="geometry" />
        </mxCell>

        <mxCell id="t-streaming-indicator" value="Listening... [Doctor speaking: 'We will also prescribe Rosuvastatin 20mg and Telmisartan 40mg...']"
          style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;fontStyle=2;align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="50" y="690" width="430" height="35" as="geometry" />
        </mxCell>

        <!-- Right Column: Real-Time Synthesized Structured SOAP Note -->
        <mxCell id="panel-soap" value=""
          style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;shadow=1;"
          vertex="1" parent="1">
          <mxGeometry x="510" y="145" width="615" height="595" as="geometry" />
        </mxCell>

        <mxCell id="hdr-soap" value="Real-Time Structured Clinical Note (SOAP) [AI Auto-Synthesizing...]"
          style="rounded=0;whiteSpace=wrap;fillColor=#ececec;strokeColor=#999999;fontSize=10;fontStyle=1;align=left;spacingLeft=10;"
          vertex="1" parent="1">
          <mxGeometry x="510" y="145" width="615" height="35" as="geometry" />
        </mxCell>

        <!-- S: Subjective -->
        <mxCell id="soap-s-box" value="SUBJECTIVE (HPI):&#xa;54-year-old male presents with 4-day history of exertional substernal chest tightness radiating to the left shoulder, relieved with rest. Denies diaphoresis, nausea, or syncope. Significant family history of premature CAD (father MI at 58)."
          style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
          vertex="1" parent="1">
          <mxGeometry x="525" y="190" width="585" height="70" as="geometry" />
        </mxCell>

        <!-- O: Objective -->
        <mxCell id="soap-o-box" value="OBJECTIVE (Exam &amp; Vitals):&#xa;BP: 168/102 mmHg (Stage 2 HTN) | HR: 104 bpm (Tachycardia) | SpO2: 93% on room air | Temp: 98.4°F&#xa;CVS: S1/S2 heard, no murmurs. Chest: Bilateral vesicular breath sounds, no rales/wheezes."
          style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
          vertex="1" parent="1">
          <mxGeometry x="525" y="270" width="585" height="65" as="geometry" />
        </mxCell>

        <!-- A: Assessment & ICD Codes -->
        <mxCell id="soap-a-box" value="ASSESSMENT &amp; CODING:&#xa;1. Suspected Unstable Angina / Acute Coronary Syndrome (ICD-10: I20.0) [Confidence: 94%]&#xa;2. Stage 2 Essential Hypertension (ICD-10: I10) [Confidence: 99%]"
          style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
          vertex="1" parent="1">
          <mxGeometry x="525" y="345" width="585" height="65" as="geometry" />
        </mxCell>

        <!-- P: Plan & Orders -->
        <mxCell id="soap-p-box" value="PLAN &amp; PRESCRIPTION:&#xa;Diagnostic: Stat 12-lead ECG, High-sensitivity Troponin-I, Lipid Profile.&#xa;Rx 1: Tab Telmisartan 40mg PO Once Daily (Morning) x 30 days&#xa;Rx 2: Tab Rosuvastatin 20mg PO Once Daily (Night) x 30 days&#xa;Rx 3: Tab Nitroglycerin 0.4mg Sublingual PRN for acute chest pain"
          style="rounded=0;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=5;"
          vertex="1" parent="1">
          <mxGeometry x="525" y="420" width="585" height="95" as="geometry" />
        </mxCell>

        <!-- CDSS Quick Alert Bar in Scribe View -->
        <mxCell id="soap-alert-bar" value="[CDSS ALERT] Systolic BP 168 mmHg + Exertional Angina meets High-Risk ACS Criteria. Stat ECG recommended."
          style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;fontStyle=1;align=left;spacingLeft=15;"
          vertex="1" parent="1">
          <mxGeometry x="525" y="525" width="585" height="35" as="geometry" />
        </mxCell>

