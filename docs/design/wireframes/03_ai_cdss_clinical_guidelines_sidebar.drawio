        <!-- CDSS Card 1: Critical Drug-Drug Interaction -->
        <mxCell id="cdss-card-ddi" value="[CRITICAL CONTRAINDICATION ALERT]&#xa;Nitroglycerin + Sildenafil Co-administration&#xa;&#xa;Severity: FATAL HYPOTENSION RISK&#xa;Description: Patient reported taking Sildenafil within 24 hours. Combining nitrates with PDE-5 inhibitors causes severe, irreversible vasodilation, profound hypotension, and cardiovascular collapse.&#xa;Recommendation: DO NOT PRESCRIBE NITRATES. Utilize alternative anti-anginal agents (e.g., Beta-blockers / Calcium Channel Blockers).&#xa;Guideline: AHA/ACC 2021 Chest Pain Guidelines"
          style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="715" y="125" width="395" height="175" as="geometry" />
        </mxCell>

        <mxCell id="btn-cdss-override-ddi" value="Override with Reason"
          style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;"
          vertex="1" parent="1">
          <mxGeometry x="725" y="260" width="140" height="25" as="geometry" />
        </mxCell>

        <mxCell id="btn-cdss-accept-ddi" value="[Accept] Remove Nitroglycerin"
          style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="880" y="260" width="220" height="25" as="geometry" />
        </mxCell>

        <!-- CDSS Card 2: Differential Diagnosis Suggestion (LLM) -->
        <mxCell id="cdss-card-dx" value="[DIAGNOSTIC GUIDANCE - Top Differentials]&#xa;&#xa;1. Acute Coronary Syndrome / Non-STEMI (Likelihood: 68%)&#xa;   • Matches: Exertional onset, left shoulder radiation, HTN, age 54, CAD family history.&#xa;&#xa;2. Aortic Dissection (Likelihood: 14%)&#xa;   • Rule out: Sudden tearing pain, pulse deficit, asymmetric BP.&#xa;&#xa;3. Gastroesophageal Reflux Disease (Likelihood: 12%)&#xa;   • Less probable given exertional trigger."
          style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="715" y="315" width="395" height="175" as="geometry" />
        </mxCell>

        <!-- CDSS Card 3: Evidence Based Clinical Orders -->
        <mxCell id="cdss-card-orders" value="[RECOMMENDED ORDERS CHECKLIST]&#xa;[X] Stat 12-Lead ECG (Within 10 mins of arrival)&#xa;[X] Serum High-Sensitivity Troponin-I at 0h and 3h&#xa;[ ] Lipid Profile &amp; Serum Electrolytes&#xa;[ ] Transthoracic Echocardiogram (Echo)"
          style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cccccc;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;"
