# ==============================================================================
# Bright Solutions COS — Staging Environment Template (.env)
# Target Server: Contabo LAMP Staging Server
# Mount Path: ~/public_html/clinicalservices.paperbirdtech.com/api/.env
# ==============================================================================

# 1. Deployment Profile
DEPLOYMENT_MODE=STAGING
DEBUG=False
HOST=127.0.0.1
PORT=8000
RELOAD=false

# 2. Staging MySQL / MariaDB Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_staging_db_user
DB_PASSWORD=your_staging_db_password
DB_NAME=your_staging_db_name

# Connection Pool Settings
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# 3. Authentication & Cryptography
# Generate secrets via: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_64_hex_chars_here_via_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_KEY=generate_64_hex_chars_here_via_python_secrets_token_hex_32

# Salt for DPDP Act Compliant Aadhaar HMAC-SHA-256 Hashing
AADHAAR_HASH_SALT=generate_32_hex_chars_here_via_python_secrets_token_hex_16

# 4. Networking & CORS Allowed Origins
CORS_ORIGINS=["https://clinicalservices.paperbirdtech.com", "http://localhost:5173", "http://localhost:3000"]

# 5. File Uploads Storage Directory
STORAGE_UPLOAD_DIR=./uploads

