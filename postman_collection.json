            "body": {
              "mode": "raw",
              "raw": "{\n  \"conclusion_notes\": \"Primary Essential Hypertension (Stage 2). Lifestyle counselled.\",\n  \"diagnosis\": \"Essential Hypertension\",\n  \"doctor_id\": 2,\n  \"doctor_override_notes\": \"Clinical alerts reviewed and accounted for.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/doctor/visits/{{visitId}}/sign-off",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctor",
                "visits",
                "{{visitId}}",
                "sign-off"
              ]
            },
            "description": "Locks encounter, signs CDSS alerts, and transitions status to READY_FOR_BILLING."
          }
        }
