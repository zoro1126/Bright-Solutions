            "description": "Transitions visit status from TRIAGED to IN_CONSULTATION."
          }
        },
        {
          "name": "Trigger Deterministic CDSS Rules Evaluation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctor/visits/{{visitId}}/insights",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctor",
                "visits",
                "{{visitId}}",
                "insights"
              ]
