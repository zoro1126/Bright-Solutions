          "name": "Get CDSS Safety Alerts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctor/visits/{{visitId}}/insights",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctor",
                "visits",
                "{{visitId}}",
                "insights"
              ]
            },
            "description": "Fetches active CDSS clinical alerts for an encounter."
