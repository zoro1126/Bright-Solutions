            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": 1,\n  \"answers\": {\n    \"q1\": 1,\n    \"q2\": 0,\n    \"q3\": 2,\n    \"q4\": 0,\n    \"q5\": 1\n  },\n  \"voice_notes\": \"Patient reports symptoms worsening after physical exertion.\"\n}"
