            "url": {
              "raw": "{{baseUrl}}/api/doctor/insights/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "doctor",
                "insights",
                "1"
              ]
            },
            "description": "Doctor acknowledges or justifies override for a critical safety insight flag."
          }
        },
        {
          "name": "Doctor Encounter Sign-off & Lock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
