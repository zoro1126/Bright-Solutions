    {
      "name": "04. Doctor Consultation & CDSS",
      "item": [
        {
          "name": "Get Doctor OPD Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctor/queue?doctor_id={{doctorId}}",
              "host": [
                "{{baseUrl}}"
